# RTP skill — environment template
#
# Copy to .env in your working directory and fill in what your path actually needs.
#   cp .env.example .env && chmod 600 .env
#
# The free half of RTP — register, complete, update, deregister — needs NOTHING in this file.
# Only the paid endpoints and the batch payout need a key.

# ─────────────────────────────────────────────────────────────────────────────
# Gateway
# ─────────────────────────────────────────────────────────────────────────────

# Base URL of the RTP gateway. Only change this if you run your own.
RTP_GATEWAY_URL=https://gateway.spraay.app

# ─────────────────────────────────────────────────────────────────────────────
# Paying for calls (buyer side)
# ─────────────────────────────────────────────────────────────────────────────
#
# Private key of the account that pays x402 charges and signs batch payouts.
# It needs USDC on Base for x402, and ETH on Base for gas if you send a batch payout.
#
# NEVER paste this key into a chat window. The skill will refuse it and point you here.
# Keep .env out of version control — the repo .gitignore already excludes it.
#
# RTP_PAYER_PRIVATE_KEY=0x...

# Optional spend ceiling in RAW BASE UNITS (USDC is 6 decimals).
# 100000 = $0.10 per call. Enforced by a paymentRequirementsSelector you pass to the
# x402 client — see knowledge/api-reference.md#spend-caps. Not a gateway-side limit.
RTP_MAX_PAYMENT_BASE_UNITS=100000

# ─────────────────────────────────────────────────────────────────────────────
# Robot identity (provider side)
# ─────────────────────────────────────────────────────────────────────────────

# Where this robot's earnings should be sent. Public — safe to commit if you like.
# If the machine has a peaqID (did:peaq:0x<address>), the address inside it works here.
# RTP_PAYMENT_ADDRESS=0x...

# The machine's peaqID, recorded in the robot's metadata as metadata.peaq_did.
# Optional — RTP works without it. The gateway stores it without verifying it.
# RTP_PEAQ_DID=did:peaq:0x...

# Public HTTPS endpoint the gateway POSTs dispatched tasks to.
# Must accept POST and return 2xx within 10 seconds. Do the work asynchronously.
# RTP_WEBHOOK_URL=https://your-server.example/rtp/task

# Assigned by the gateway at registration (robo_<16 hex>). Save it — there is no
# lookup-by-name endpoint. The skill also writes it to .rtp-robot.json.
# RTP_ROBOT_ID=robo_...

# ─────────────────────────────────────────────────────────────────────────────
# Network reference — informational, not read by any tool
# ─────────────────────────────────────────────────────────────────────────────
#
# Base mainnet chain ID              8453   (x402 network id: eip155:8453)
# USDC on Base                       0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  (6 decimals)
# Spraay batch contract (Base only)  0x1646452F98E36A3c9Cfc3eDD8868221E207B5eEC
# Batch protocol fee                 0.3% (30 bps), added on top of the payout total
# Batch recipient limit              200 per transaction
#
# Base Sepolia is 84532 — the gateway's RTP and batch routes are mainnet only.

{
  "name": "peaqos",
  "version": "0.1.0",
  "description": "Onboard machines and fleet operators to peaqOS — peaq's financial OS for autonomous machines — using the peaq-os-cli Python CLI. Handles machine registration, peaqID creation, Machine NFT minting, Machine Credit Rating (MCR) setup, event submission, and fleet management. Works on both agung testnet and mainnet. Adapts to developers and non-technical operators alike.",
  "entrypoint": "AGENT-PROMPT.md",
  "capabilities_required": [
    "shell_exec",
    "file_read",
    "web_fetch",
    "interactive_input"
  ],
  "knowledge_files": [
    "GUIDE.md",
    "knowledge/decision-tree.md",
    "knowledge/concepts.md",
    "knowledge/cli-reference.md",
    "knowledge/troubleshooting.md",
    "examples/.env.example"
  ],
  "adapters": [
    "adapters/claude-code/SKILL.md"
  ],
  "cli_dependency": {
    "package": "peaq-os-cli",
    "pypi": true,
    "install": "pip install peaq-os-cli",
    "install_from_source": "https://github.com/peaqnetwork/peaq-os-cli-py",
    "python_min": "3.11"
  },
  "keywords": [
    "peaq", "peaqos", "peaqid", "mcr", "depin", "machine-economy",
    "machine-nft", "machine-credit-rating", "did", "onboarding", "blockchain"
  ],
  "links": {
    "homepage": "https://peaq.xyz",
    "docs": "https://docs.peaq.xyz",
    "explorer_testnet": "https://testnet.peaqscan.xyz/",
    "explorer_mainnet": "https://peaqscan.xyz/",
    "faucet": "https://docs.peaq.xyz/peaqchain/build/getting-started/get-test-tokens"
  }
}

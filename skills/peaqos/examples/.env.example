# peaqOS CLI — environment configuration
# Copy this file to .env in your project root and fill in the values.
# Run `peaqos init` for an interactive setup wizard that writes this file for you.
#
# SECURITY: Never commit .env to version control. Add it to .gitignore.
# SECURITY: PEAQOS_PRIVATE_KEY must stay in this file or a shell env var — never paste it into chat.

# ── Identity ────────────────────────────────────────────────────────────────

# Option A — Raw private key (0x-prefixed 64-hex). Required for all write commands if not using OWS.
# Generate a fresh keypair: peaqos init → choose "generate"
PEAQOS_PRIVATE_KEY=0x

# Option B — OWS encrypted vault wallet (alternative to PEAQOS_PRIVATE_KEY)
# Requires: pip install "peaq-os-sdk[ows]"
# Create a wallet: peaqos wallet create <name>
# Set as active:   peaqos wallet use <name>  (writes this line automatically)
# PEAQOS_OWS_WALLET=my-operator

# OWS vault passphrase — prompted interactively if not set.
# Storing here is convenient but reduces the security benefit of OWS.
# Prefer: export OWS_PASSPHRASE="..." in your shell session instead.
# OWS_PASSPHRASE=

# ── Network ─────────────────────────────────────────────────────────────────

# "mainnet" or "testnet" (agung)
PEAQOS_NETWORK=testnet

# RPC endpoint. Defaults are filled in by `peaqos init` based on PEAQOS_NETWORK.
# Mainnet:  https://peaq.api.onfinality.io/public
# Testnet:  https://peaq-agung.api.onfinality.io/public
PEAQOS_RPC_URL=https://peaq-agung.api.onfinality.io/public

# ── APIs ────────────────────────────────────────────────────────────────────

# MCR REST API (read-only, no auth required)
# Same URL on both networks — `peaqos init` fills this in for you.
PEAQOS_MCR_API_URL=https://mcr.peaq.xyz

# Gas Station URL (used by `peaqos activate` for 2FA-gated funding)
# Mainnet:  https://depinstation.peaq.xyz
# Testnet:  NOT available on agung — fund via web faucet instead:
#           https://docs.peaq.xyz/peaqchain/build/getting-started/get-test-tokens
#           Then run `peaqos activate --skip-funding`
PEAQOS_GAS_STATION_URL=

# ── Contract addresses ───────────────────────────────────────────────────────
# `peaqos init` fetches mainnet addresses automatically from GitHub.
# Testnet (agung) addresses are listed below — fill in for PEAQOS_NETWORK=testnet.
# Mainnet addresses are fetched on demand; leave blank if using mainnet + `peaqos init`.

# Mainnet: fetched automatically    Testnet (agung): 0x9E9463a65c7B74623b3b6Cdc39F71be7274e5971
IDENTITY_REGISTRY_ADDRESS=0x9E9463a65c7B74623b3b6Cdc39F71be7274e5971

# Mainnet: fetched automatically    Testnet (agung): 0x55f336714aDb0749DbFE33b057a1702405564E3d
IDENTITY_STAKING_ADDRESS=0x55f336714aDb0749DbFE33b057a1702405564E3d

# Mainnet: fetched automatically    Testnet (agung): 0x2DAD8905380993940e340C5cE6d313d5c2780040
EVENT_REGISTRY_ADDRESS=0x2DAD8905380993940e340C5cE6d313d5c2780040

# Mainnet: fetched automatically    Testnet (agung): 0xB41C2A4f1c19b6B06beaAce0F5CD8439e77C4b1c
MACHINE_NFT_ADDRESS=0xB41C2A4f1c19b6B06beaAce0F5CD8439e77C4b1c

# Precompile — same on all peaq networks
DID_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000800

# Precompile — same on all peaq networks
BATCH_PRECOMPILE_ADDRESS=0x0000000000000000000000000000000000000805

# ── Scale / Machine Market ───────────────────────────────────────────────────
# Required for all `peaqos scale` commands.
# Contact your platform admin or the peaqOS team for the URL that applies to you.
#
# CLI version note: scale commands require peaq-os-cli that ships the `scale`
# command group. If `peaqos scale --help` returns "No such command 'scale'",
# upgrade with `pip install --upgrade peaq-os-cli`.

# Base URL of the Machine Markets API.
# Default production endpoint — used unless your platform admin gave you a different one.
PEAQOS_ORCHESTRATION_URL=https://orchestration.peaq.xyz

# Platform API key for orchestration (optional — only required if the deployment
# you are connecting to enforces API key auth).
# If you receive an AUTH_REQUIRED error on a Scale command, set this value.
# Treat as a secret — do not commit.
# PEAQOS_ORCH_API_KEY=
